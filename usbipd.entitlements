<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the `usbipd` daemon itself. Signed into the binary by
  .github/workflows/release.yml.

  usbipd is the binary that calls OSSystemExtensionRequest, so it — not the extension
  bundle — is what needs the system-extension install entitlement.

  Removed 2026-08-05:
    com.apple.security.get-task-allow
      A debug entitlement that lets any process attach a debugger to this one. It must
      never ship in a signed release; it also fails notarization.
-->
<plist version="1.0">
<dict>
	<!-- Required to submit the system extension for installation. -->
	<key>com.apple.developer.system-extension.install</key>
	<true/>

	<!--
	  Apple's guidance on FB22897007. This is an App Sandbox entitlement and usbipd is
	  not sandboxed, so it is expected to have no effect; retained until
	  Scripts/validate-usb-entitlements.sh measures whether that is true.
	-->
	<key>com.apple.security.device.usb</key>
	<true/>
</dict>
</plist>

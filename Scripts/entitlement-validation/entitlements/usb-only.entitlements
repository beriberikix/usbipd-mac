<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Apple's suggestion from FB22897007, taken literally: add
  com.apple.security.device.usb directly to the entitlements file, no request needed.

  Note that this key is an App Sandbox entitlement. Without
  com.apple.security.app-sandbox it has nothing to relax, so the expected result is
  that this variant is indistinguishable from `baseline`. Measuring that is the
  point of the variant.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.usb</key>
	<true/>
</dict>
</plist>

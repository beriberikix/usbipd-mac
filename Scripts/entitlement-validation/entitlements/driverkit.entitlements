<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The entitlements that actually gate taking a USB device away from its in-kernel
  driver. These are managed capabilities: they are only honoured when they also
  appear in an Apple-issued provisioning profile embedded in the binary.

  Ad-hoc signing this set is expected to fail at launch (AMFI kills the process),
  and that failure is the evidence: it is a different, and far higher, bar than the
  App Sandbox entitlement Apple pointed at in FB22897007.

  Note the exact key spelling: com.apple.developer.driverkit.transport.usb.
  Sources/SystemExtension/SystemExtension.entitlements currently spells this
  com.apple.developer.driverkit.usb.transport, which is not a real entitlement key
  and is silently ignored — see Documentation/development/entitlement-validation.md.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.driverkit</key>
	<true/>
	<key>com.apple.developer.driverkit.transport.usb</key>
	<true/>
	<key>com.apple.developer.driverkit.allow-any-userclient-access</key>
	<true/>
</dict>
</plist>
